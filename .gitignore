# --- Large binary artifacts: shipped as a GitHub Release / Zenodo, not in git ---
# Rebuild the release archive from a full tree with scripts/package_release.py.
models/
results/dim_runs/*.pt
results/dim_runs/*.npy
results/**/*.pt
results/**/*.npy
results/paper_experiments/*.npy

# Raw ICD-10 download (137 MB, regenerable: scripts/download_icd10.py)
data/raw/

# Processed pickles (regenerable from the tracked CSV: scripts/make_legacy_pickle.py)
data/processed/*.pkl

# --- Private research record (identity-bearing; kept local, never pushed) ---
private/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.DS_Store

# Regenerated tables (rebuild with scripts/make_tables.py)
results/tables/
